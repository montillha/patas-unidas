# Usado pelo docker-compose.yml. Copie para .env (que não é commitado) e ajuste:
#   cp .env.example .env

# Obrigatório. Gere um valor aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Opcionais (estes são os valores padrão). Atenção: o Postgres só lê usuário/senha/banco
# na primeira criação do volume — para trocar depois, rode `docker compose down -v`
# (apaga os dados do banco).
DB_NAME=patas_unidas
DB_USER=patas_unidas
DB_PASSWORD=patas_unidas
